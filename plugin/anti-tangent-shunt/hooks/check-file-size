# distributed under the License is distributed on an "AS IS" BASIS,
# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
# See the License for the specific language governing permissions and
# limitations under the License.
#
# Ported from spotify/portal-ai-plugins (plugins/shunt/hooks/check-file-size),
# commit 3c24ca30ff63e1f5bbad1c43fe5324daff579123. Upstream ships this licence
# via a repository-root LICENSE file rather than a per-file header; this
# header carries the licence and attribution with the file.
#
# Modified 2026-09 for anti-tangent-mcp: replaced the Portal/AiKA delegation
# target with the anti-tangent MCP tools. Further modified 2026-09 to close a
# confirmed bypass: Read{offset: N} with no `limit` was treated as a
# "targeted read" and allowed straight through, regardless of N — including
# N=0, which is really just "no offset at all". See the comment above the
# limit check below.

set -uo pipefail

# Block full-file reads on large files; point the caller at
# mcp__anti-tangent__bulk_read instead. Self-contained: all routing logic
# lives here, no CLAUDE.md needed.
#
# PreToolUse hook for Read. Block = exit 2 with the reason on stderr.
# Allow = exit 0, silent. Any unexpected/ambiguous condition falls through
# to allow — this hook must never be the reason a legitimate read fails.

MIN_LINES="${ANTI_TANGENT_SHUNT_MIN_LINES:-350}"
case "$MIN_LINES" in ''|*[!0-9]*) MIN_LINES=350 ;; esac

input=$(cat)

file_path=$(echo "$input" | jq -r '.tool_input.file_path // empty')
limit=$(echo "$input" | jq -r '.tool_input.limit // empty')

# Allow targeted reads: only `limit` genuinely bounds how many lines come
# back. `offset` alone does not — without a limit, Read defaults to reading
# up to 2000 lines starting at the offset, which can still be most or all of
# a large file, so offset is never consulted here. (offset: 0 was the
# confirmed bypass: it was treated as "offset set" and allowed through, but
# an offset of 0 with no limit is really just an unbounded read of the
# file's start — no different from no offset at all.)
#
# Test *presence* via jq's `// empty`, not truthiness: `limit: 0` is a
# legitimate (if unusual) value and must count as present. Do not "simplify"
# this to something like `[ "$limit" -gt 0 ]` — that would silently
# reintroduce the same class of falsy-value bug for limit: 0.
if [ -n "$limit" ]; then
  exit 0
fi

# Allow if file doesn't exist or path is empty — let Read emit its own error.
if [ -z "$file_path" ] || [ ! -f "$file_path" ]; then
  exit 0
fi

# Allow small files — delegation overhead isn't worth it.
lines=$(wc -l < "$file_path" 2>/dev/null | tr -d ' ')

# Unreadable or otherwise unmeasurable file (permission denied, race with a
# deletion, etc.): $lines is empty or non-numeric. The `|| echo "0"` a
# previous version of this line relied on can never fire — `tr` succeeds
# even when `wc` fails — so check the value itself instead. This hook must
# never be the reason a legitimate (if unreadable) read fails; allow through
# and let Read report the real error.
case "$lines" in
  ''|*[!0-9]*) exit 0 ;;
esac

if [ "$lines" -le "$MIN_LINES" ]; then
  exit 0
fi

printf 'FILE TOO LARGE TO READ DIRECTLY (%d lines, threshold %d)

Reading this whole file would put ~%d lines into your context. Ask the
question instead:

  mcp__anti-tangent__bulk_read
    question: "<the specific thing you need to know>"
    paths:    ["%s"]

Ask a QUESTION, not "summarise this file" — you get back bullets, not prose.

If you need to EDIT this file, follow the answer with a targeted read of the
region it names: Read(file_path="%s", offset=<n>, limit=<n>). Targeted reads
are never blocked.

(Disable: ANTI_TANGENT_SHUNT_MIN_LINES=999999)
' "$lines" "$MIN_LINES" "$lines" "$file_path" "$file_path" >&2
exit 2
