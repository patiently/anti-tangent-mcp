#!/usr/bin/env bash
# PostToolUse hook: DETECT a task close that skipped anti-tangent's
# validate_completion gate, or ran it and read `fail`, and mandate recovery
# before the agent's next action. It does NOT prevent the close — see below.
#
# WHY PostToolUse ON TaskUpdate, not SubagentStop: anti-tangent's model is one
# task = one session = one subagent, which points at SubagentStop. But plans are
# executed two ways — executing-plans runs tasks in the controller's own
# session, subagent-driven-development dispatches one subagent per task. Only
# the TaskUpdate close is common to both, and both leave a detectable trace
# there (see the two pass signals below).
#
# WHY exit 2 AFTER the close rather than PreToolUse: closing the task is
# legitimate; closing it without the gate is not. exit 2 sends stderr back as
# something the model must address before its next action, without refusing a
# state change that may well be correct.
#
# FAILS OPEN, ALWAYS. A guard that blocks work because it broke is worse than
# the drift it prevents.
#
# INTERFACE CONTRACT: the marker strings this hook matches below
# ("anti-tangent envelope", "session_id:", "tool: validate_completion") and
# the verdict regex are pinned by internal/mcpsrv/summary_contract_test.go.
# That test exists precisely so a future change to formatEnvelopeSummary's
# wording cannot silently disarm this guard — update the patterns here in the
# same commit as any change there.
#
# THE tool: MARKER MATTERS: validate_task_spec, check_progress, and
# validate_completion all render byte-identical "anti-tangent envelope"
# blocks except for this line (internal/mcpsrv/summary.go's
# formatEnvelopeSummary is shared verbatim by all three). Without requiring
# "tool: validate_completion" specifically, a check_progress or
# validate_task_spec block pasted into a report would satisfy this guard's
# pass signal, and that tool's verdict would be misread as validate_completion's.
# An untagged block (no tool: line at all — e.g. from a pre-0.18.0 server)
# does NOT satisfy the guard; see README.md's version note.
#
# POSITIONAL EXTRACTION, NOT FREE SCAN: the
# tool:/verdict: lines are read from a FIXED position — the first line
# matching each pattern WITHIN one envelope block — never by searching a
# block's full text for the pattern anywhere in it. A finding's Evidence (or
# Criterion, or next_action) is reviewer-authored free text constrained only
# to be non-empty; multi-line values are deliberately supported and rendered
# verbatim, just re-indented. Without positional extraction, a check_progress
# block whose Evidence happened to contain the literal line
# "tool: validate_completion" would satisfy this guard's pass signal, and a
# real "verdict: fail" could be overridden by a forged "verdict: pass" the
# same way. Both are unreachable now: formatEnvelopeSummary always emits
# tool:/session_id:/verdict: in the header region, before any finding is
# rendered — so within a genuine block the FIRST match is always the real
# one — and the server also escapes every continuation line of a
# multi-line field with a non-whitespace "| " sentinel
# (internal/mcpsrv/summary.go's escapeContinuationLines) so it can never
# match ^\s*label: or a bare header line at all, closing the same hole even
# if a forged line were somehow positioned before the genuine one. Both
# fixes matter, and they are NOT interchangeable: positional extraction is a
# within-block defence and needs nothing from the server, but it cannot stop
# a forged block BOUNDARY — a bare "anti-tangent envelope" at column 0 inside
# a field starts a NEW block, which this hook then parses positionally and
# entirely correctly out of text a reviewer wrote. Only source-side escaping
# closes that, and only on a server new enough to have it.
# internal/mcpsrv/summary_forgery_test.go enumerates the server's block
# renderers by what their output is ASSIGNED TO (a summary_block), not by
# what header literal they write: plan_run_report's header is legitimately
# different, so a header-keyed enumeration does not see it at all. That test
# states its own blind spots in its header; neither it nor this hook makes
# the marker path trustworthy, since an agent can compose a block in its own
# report text (README.md, "How much to trust each pass signal"). Across
# blocks, the LAST one wins.
#
# THE DIRECT-CALL RESULT IS ALSO READ FOR ITS VERDICT: a real MCP tool
# result arrives JSON-MARSHALLED (envelopeResult,
# internal/mcpsrv/handlers.go) — summary_block's newlines survive only as
# "\n" escapes inside one JSON string, on one physical line, so HEADER_RE
# below can never match a validate_completion tool_result's raw text.
# Without more, that left the direct-call path — the one signal that
# cannot be fabricated — blind to `verdict: fail`: `called` would be true
# and the close would pass regardless of what the gate actually returned.
# The script below matches each validate_completion tool_use to its
# tool_result by `tool_use_id`, parses that result as JSON, and — on
# success — synthesizes a minimal textual envelope block from its
# tool/session_id/verdict fields and feeds it through the SAME
# positional-extraction / tool-scoping / last-block-wins code path a pasted
# marker block goes through, rather than a second, parallel algorithm. A
# result that fails to parse as JSON, or whose "tool" field is not
# "validate_completion", contributes nothing — the pre-existing `called`
# signal still covers that case.
set -uo pipefail

# The comment-hygiene scan below reuses comment_scan.py, which lives beside
# this script under hooks/. It has no CLAUDE_PLUGIN_ROOT of its own to read
# (unlike check-comment-write's separate Python body), so this hook derives
# the plugin root itself and hands it to the embedded interpreter explicitly
# as ATG_ROOT — an import that silently never happens looks identical to "no
# violations found", so this must not be left to inherit anything.
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

TRACE_LOG="${ANTI_TANGENT_GUARD_TRACE_LOG:-/tmp/claude-hooks/anti-tangent-guard.log}"
# Mode 700 on creation: the default lives in a world-writable directory, so a
# directory this hook creates must not be one another account can drop files
# into. `-m` applies only to directories mkdir actually creates — an existing
# directory keeps whatever mode it has, which is why trace() below independently
# refuses to write through a symlink.
mkdir -p -m 700 "$(dirname "$TRACE_LOG")" 2>/dev/null || true

# Short session id so one shared trace file stays readable when several
# sessions write to it. Lines emitted before the payload is parsed carry "-",
# which is honest about not knowing rather than silently blank.
ATG_SESSION="-"
atg_set_session() {
    local raw
    raw=$(printf '%s' "${1:-}" | jq -r '.session_id // empty' 2>/dev/null) || return 0
    # Restrict to a safe character class before truncating: jq -r turns a
    # JSON "\n" into a real newline, and truncating by character count alone
    # would let it (or a "|") survive into the printf argument and split one
    # trace() call into more than one physical log line.
    raw="${raw//[^A-Za-z0-9_-]/}"
    [[ -n "$raw" ]] && ATG_SESSION="${raw:0:8}"
    return 0
}

# Best-effort rotation. A trace log that grows without bound eventually costs
# more than it tells you. Rotating by rename rather than truncating in place
# means a concurrent appender simply starts a fresh file instead of writing
# into a hole.
atg_rotate_trace() {
    local max=${ANTI_TANGENT_GUARD_TRACE_MAX_BYTES:-1048576} size
    # [[ -gt ]] evaluates both sides arithmetically. Validate the env-supplied
    # cap before it ever reaches that comparison: under set -u, a non-numeric
    # value there aborts the whole script rather than tripping the "|| return
    # 0" a few lines down, which turns a malformed cap into a hook that skips
    # its own gate. Falling back to the default keeps this best-effort.
    [[ "$max" =~ ^[0-9]+$ ]] || max=1048576
    [[ -L "$TRACE_LOG" ]] && return 0
    [[ -f "$TRACE_LOG" ]] || return 0
    size=$(wc -c < "$TRACE_LOG" 2>/dev/null) || return 0
    [[ "$size" -gt "$max" ]] || return 0
    mv -f "$TRACE_LOG" "$TRACE_LOG.1" 2>/dev/null || true
    return 0
}
atg_rotate_trace

trace() {
    # Refuse to append through a symlink. The default trace path is predictable
    # and its parent may be world-writable, so a symlink planted there would
    # otherwise redirect every appended line into a file of someone else's
    # choosing. Every failure path here is swallowed: a trace that cannot be
    # written must never change this hook's exit status.
    [[ -L "$TRACE_LOG" ]] && return 0
    # Scrub the field separators out of every argument, at the sink, so no
    # caller has to remember to. The task id, the status and the tool name all
    # arrive here straight from the hook payload, and jq -r renders a JSON
    # "\n" as a real newline: a newline reaching printf splits one call into
    # two physical lines, and the second parses as a genuine record — a
    # "pass", say. A "|" does the same to the column layout. Only the session
    # id is sanitized where it is captured instead, because it is also
    # truncated there and truncating an unsanitized value is what lets a
    # newline through.
    local task=${1:-?} ev=${2:-?} detail=${3:-}
    task=${task//[$'\r\n|']/}
    ev=${ev//[$'\r\n|']/}
    detail=${detail//[$'\r\n|']/}
    printf '%s | s=%s | guard | task=%s | %s%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$ATG_SESSION" "${task:-?}" "${ev:-?}" "${detail:+ | $detail}" \
        >> "$TRACE_LOG" 2>/dev/null || true
}

# Two switches, two concerns. COMPLETION_GUARD governs whether a close is
# checked for having run validate_completion at all; COMMENT_GUARD governs
# the comment-hygiene scan over the evidence that call submitted. Neither
# implies the other, so the hook exits early only when both are off — a
# variable that names one concern must not silently disable the other.
COMPLETION_GUARD="${ANTI_TANGENT_COMPLETION_GUARD:-1}"
COMMENT_GUARD="${ANTI_TANGENT_COMMENT_GUARD:-1}"
if [[ "$COMPLETION_GUARD" == "0" && "$COMMENT_GUARD" == "0" ]]; then
    trace "?" "skip" "guard=0"
    exit 0
fi
trap 'trace "?" "error" "trap-ERR"; exit 0' ERR
command -v jq >/dev/null 2>&1      || { trace "?" "skip" "no-jq"; exit 0; }
command -v python3 >/dev/null 2>&1 || { trace "?" "skip" "no-python3"; exit 0; }

INPUT=$(cat)
atg_set_session "$INPUT"
TOOL_NAME=$(echo "$INPUT" | jq -r '.tool_name // empty' 2>/dev/null | tr -d '\r')
[[ "$TOOL_NAME" != "TaskUpdate" ]] && { trace "?" "skip" "tool=$TOOL_NAME"; exit 0; }
STATUS=$(echo "$INPUT" | jq -r '.tool_input.status // empty' 2>/dev/null | tr -d '\r')
[[ "$STATUS" != "completed" ]] && { trace "?" "skip" "status=$STATUS"; exit 0; }
TASK_ID=$(echo "$INPUT" | jq -r '.tool_input.taskId // empty' 2>/dev/null | tr -d '\r')
[[ -z "$TASK_ID" ]] && { trace "?" "skip" "no-task-id"; exit 0; }
TRANSCRIPT=$(echo "$INPUT" | jq -r '.transcript_path // empty' 2>/dev/null | tr -d '\r')
[[ -z "$TRANSCRIPT" || ! -f "$TRANSCRIPT" ]] && { trace "$TASK_ID" "skip" "no-transcript"; exit 0; }

# Walk the transcript for the two pass signals. Python, not jq: the entries nest
# content blocks inside tool_result inside message.content. Task identity is a
# direct string comparison against TaskUpdate.input.taskId — every TaskUpdate
# call carries its own taskId, so no reconstruction from creation order is
# needed.
#
# NO APOSTROPHES ANYWHERE BELOW, code or comment: the whole body is one
# single-quoted bash string, so a lone ' closes it and the rest of the
# program becomes shell words. Use double quotes in Python, and rephrase
# English possessives.
PY='
import json, os, re, sys, time
path, task_id = sys.argv[1], str(sys.argv[2])
try:
    lines = open(path).readlines()
except Exception:
    print(json.dumps({"error": True})); sys.exit(0)

last_inprogress = -1
called_idx, texts = [], []   # (idx) of direct calls; (idx, text) of tool_result chunks
call_ids = {}                # tool_use id -> idx, for validate_completion calls only
completion_inputs = []       # (idx, input) for every validate_completion call, in order

for idx, line in enumerate(lines):
    try: entry = json.loads(line)
    except Exception: continue
    etype = entry.get("type")
    msg = entry.get("message") or {}
    if etype == "assistant":
        for c in msg.get("content") or []:
            if not isinstance(c, dict): continue
            if c.get("type") == "tool_use":
                name, inp = c.get("name", ""), (c.get("input") or {})
                if name == "mcp__anti-tangent__validate_completion":
                    called_idx.append(idx)
                    completion_inputs.append((idx, inp))
                    tuid = c.get("id")
                    if tuid:
                        call_ids[tuid] = idx
                elif name == "TaskUpdate":
                    tid = str(inp.get("taskId", ""))
                    if tid == task_id and inp.get("status") == "in_progress":
                        last_inprogress = idx
    elif etype == "user":
        content = msg.get("content")
        if isinstance(content, list):
            for c in content:
                if not isinstance(c, dict) or c.get("type") != "tool_result": continue
                inner = c.get("content")
                chunks = [inner] if isinstance(inner, str) else [
                    ic.get("text", "") for ic in (inner or []) if isinstance(ic, dict) and ic.get("type") == "text"]
                for t in chunks:
                    if t and "anti-tangent envelope" in t:
                        texts.append((idx, t))
                # Direct-call verdict (see header comment above this PY
                # block): match this tool_result to a validate_completion
                # tool_use by id, parse its JSON body, and synthesize a
                # textual block that flows through the same header-anchored
                # extraction as a pasted marker.
                tuid = c.get("tool_use_id")
                if tuid in call_ids:
                    try:
                        parsed = json.loads("".join(chunks))
                    except Exception:
                        parsed = None
                    if isinstance(parsed, dict) and parsed.get("tool") == "validate_completion" and parsed.get("verdict"):
                        synth = ("anti-tangent envelope\n"
                                 "  tool:          validate_completion\n"
                                 "  session_id:    " + str(parsed.get("session_id", "")) + "\n"
                                 "  verdict:       " + str(parsed.get("verdict", "")) + "\n")
                        texts.append((idx, synth))

scan_from = last_inprogress if last_inprogress >= 0 else 0
called = any(i >= scan_from for i in called_idx)

# Positional block extraction. A genuine
# envelope always starts with a bare "anti-tangent envelope" header line --
# no leading whitespace, nothing else on the line; formatEnvelopeSummary
# writes exactly that -- followed, before any finding is rendered, by
# session_id:, then tool:, then verdict:. Split the in-window transcript
# text on that anchored header to get one block per envelope; within each
# qualifying block, the FIRST tool: line and FIRST verdict: line are always
# the genuine ones -- a later line spelled the same way, reachable only
# through a finding Evidence/Criterion or next_action, can never win a
# first-match search over a block whose header always comes first.
HEADER_RE = re.compile(r"(?m)^anti-tangent envelope$")
TOOL_RE = re.compile(r"(?m)^\s*tool:\s*(\S+)\s*$")
VERDICT_RE = re.compile(r"(?m)^\s*verdict:\s*(\w+)")

in_window = [t for (i, t) in texts if i >= scan_from]
combined = "\n".join(in_window)

starts = [m.start() for m in HEADER_RE.finditer(combined)]
blocks = []
for i, s in enumerate(starts):
    e = starts[i + 1] if i + 1 < len(starts) else len(combined)
    blocks.append(combined[s:e])

# A block only qualifies as the validate_completion pass signal when its
# FIRST tool: line names it -- not merely when that string appears
# somewhere in the block. A check_progress block whose Evidence happens to
# contain the literal line "tool: validate_completion" must NOT qualify.
qualifying = []
for b in blocks:
    if "session_id:" not in b:
        continue
    tm = TOOL_RE.search(b)
    if tm and tm.group(1) == "validate_completion":
        qualifying.append(b)

# LAST qualifying block wins: a re-validation after fixing findings is the
# whole point. Its verdict is the FIRST verdict: line within that block --
# the genuine one, always emitted before any finding.
verdict = ""
if qualifying:
    vm = VERDICT_RE.search(qualifying[-1])
    if vm: verdict = vm.group(1)

# Comment-hygiene scan over the diff evidence of the LAST validate_completion
# call in the task window -- defence in depth for a comment that carries
# change history and reached disk without passing through Edit/Write (a Bash
# heredoc, most commonly), so the write-time hook never saw it. Only the
# LAST call is scanned: a re-validation after rewriting a flagged comment
# must close on the diff it submitted, not on an earlier submission in the
# same window.
def diff_added_lines(inp):
    """Return {path: [added lines]} from a validate_completion input dict.

    This parser is a robustness surface for honest-but-odd diffs, NOT a
    security control. `final_diff` is written by the party being checked,
    and two documented behaviours defeat the scan outright without going
    near the parser: an explicitly empty `final_diff` still wins by
    precedence over `final_files`, leaving nothing to read; and the path in
    a "+++ " header is taken on trust, so a submitter who names their file
    with an extension the scan excludes skips it. What is left for the
    parser to get right is diffs written oddly but in good faith.

    Three shapes are read wrong, and none of them is worth chasing. Two are
    inherited from the declared counts; the third is the price of the pair
    tell and is the only one here that misreads a WELL-FORMED diff.

    UNDER-DECLARED COUNT: a hunk that declares FEWER added lines than it
    delivers spends its count early, so a later added line whose content
    starts with "++ " reads as a file header and re-points the scan at a
    path the diff body itself named.

    OVER-DECLARED COUNT UNDER A BARE HEADER: a hunk that declares MORE
    added lines than it delivers is still open when the next file starts,
    so a "+++ " header with no "--- " line above it is charged to that hunk
    rather than read as a header, and every added line after it is filed
    under the path above. Two tells rescue the ordinary spellings -- a
    "--- "/"+++ " pair, and a header an "@@" follows while the hunk owes at
    least two added lines -- and what neither tell reaches is the residual.

    A "-- "/"++ " CONTENT COLLISION: the price of the pair tell. A removed
    line whose content starts "-- " sitting immediately above an added line
    whose content starts "++ " ends its hunk and re-points the scan at
    whatever that second line names. A real diff OF a diff does NOT do this:
    git writes those with four markers, "---- a/x" above "++++ b/x", which
    the tell does not match. The trigger is ordinary source text.

    Each of the three lands the added lines that follow on a path the diff
    body named rather than the one it meant, and what that costs depends on
    the invented path. Where it has no scannable extension the scan goes
    SILENT and a comment carrying a tell reaches disk unflagged. Where it
    has one the close is BLOCKED against a file the diff never touched, and
    nothing the implementer can edit clears it -- the worse direction of the
    two, because this hook is built to fail open. Each has an eval case
    pinning the behaviour described here, so the boundary is asserted rather
    than rediscovered.
    """
    text = inp.get("final_diff") or ""
    if not text:
        p = inp.get("final_diff_path") or ""
        if not p or not os.path.isabs(p):
            return {}
        # read_text_capped applies the same three guards the server applies to
        # this field -- O_NOFOLLOW, O_NONBLOCK, S_ISREG -- plus the byte cap
        # and the replacing decode. Anything but text fails OPEN here: this
        # scan is defence in depth, and an unreadable diff must not turn into
        # a blocked task close.
        text = read_text_capped(p)
        if not isinstance(text, str):
            return {}
    lines = text.splitlines()
    out, cur = {}, None
    # Lines the open hunk still owes on each side; 0/0 means no hunk is open.
    # The bytes of a "+++ " file header and of an added line whose content
    # starts with "++ " are identical, so the line alone cannot say which it
    # is. Two things can. The length the hunk declared for itself: while a
    # hunk still owes added lines a "+++ " belongs to its body, and once the
    # count is spent the hunk is closed and the next one is a header again.
    # And a "--- " sitting immediately above it, which no declared count
    # overrides.
    old_left = new_left = 0
    for i, line in enumerate(lines):
        m = HUNK_HEADER_RE.match(line)
        if m:
            # An omitted count is one line: "@@ -1 +1 @@".
            old_left = 1 if m.group(1) is None else int(m.group(1))
            new_left = 1 if m.group(2) is None else int(m.group(2))
            continue
        nxt = lines[i + 1] if i + 1 < len(lines) else ""
        # A "--- " line immediately above a "+++ " line is a file header
        # pair whatever an open hunk still owes: every file boundary in a
        # unified diff emits those two lines adjacent, and no count a hunk
        # declared for itself makes the pair mean anything else. Closing the
        # hunk here re-anchors the scan on the path the pair names, instead
        # of charging both lines to the file above and filing every later
        # added line there too. What it costs is a diff OF a diff -- see the
        # docstring.
        if line.startswith("--- ") and nxt.startswith("+++ "):
            old_left = new_left = 0
        if old_left or new_left:
            # Each body line is charged to the side it belongs to, except
            # the no-newline marker, which belongs to neither. Three things
            # end the hunk early instead of being charged: a line carrying no
            # diff marker at all, a marker the declared counts have no room
            # left for, and a "+++ " that a new "@@" follows WHILE THE HUNK
            # STILL OWES AT LEAST TWO ADDED LINES -- a diff cut short of the
            # length it declared, whose remaining files must not be
            # swallowed. The "at least two" is load-bearing: when the
            # "+++ " is the LAST added line the hunk owes, a following "@@" is
            # exactly what a well-formed diff produces -- under -U0 the next
            # hunk of the same file starts on the very next line -- so ending
            # the hunk there would file the rest of that file under a path
            # invented by the hunk body itself.
            if (line.startswith("+") and new_left
                    and not (line.startswith("+++ ") and nxt.startswith("@@")
                             and new_left > 1)):
                new_left -= 1
                if cur:
                    out[cur].append(line[1:])
                continue
            if line.startswith("-") and old_left:
                old_left -= 1
                continue
            if line.startswith(" ") or line == "":
                old_left = max(0, old_left - 1)
                new_left = max(0, new_left - 1)
                continue
            if line.startswith("\\"):
                continue
            old_left = new_left = 0
        if line.startswith("+++ "):
            cur = diff_path(line[4:].strip())
            # The "+++" side of a deletion. It names no file that exists
            # after the change, and setdefault would otherwise enter it as a
            # path the scan considered.
            if cur == "/dev/null":
                cur = None
            else:
                out.setdefault(cur, [])
        elif cur and line.startswith("+"):
            out[cur].append(line[1:])
    return out


# A hunk header states how many lines the hunk holds on each side. Both counts
# are optional and mean one line when absent. A combined diff writes "@@@" and
# three ranges; it does not match here, so such a hunk opens none and every
# "+++ " in it reads as a header -- the reading that scans the most, since a
# path this parser never opens has its lines dropped.
HUNK_HEADER_RE = re.compile(r"^@@ -\d+(?:,(\d+))? \+\d+(?:,(\d+))? @@")


# The letters git puts in front of a diff path: "a"/"b" by default, and
# "c" (commit), "i" (index), "w" (working tree), "o" (object) under
# diff.mnemonicPrefix. Not the whole set it can emit -- a mnemonic-prefixed
# `diff --no-index` numbers its two sides "1/" and "2/" instead. Those stay on
# the path, which costs the scan nothing: whether a path is scanned at all is
# decided by its extension, and the leading segment only shows up in the path
# a violation is reported against.
GIT_PATH_PREFIXES = frozenset("abciwo")


def diff_path(raw):
    """Strip the one-character path prefix from a "+++" header. -> path.

    That prefix is git configuration, not diff syntax: "b/" by default,
    "w/" or "i/" under diff.mnemonicPrefix, and nothing at all under
    diff.noprefix. Requiring "b/" discards every added line of a diff
    written under the other two, which is indistinguishable from a scan
    that ran and found nothing. Stripping ANY one-character first segment
    would eat a real top-level directory of one character, so only the
    prefix letters git itself emits are stripped -- at the cost of
    mis-reading an unprefixed path whose top-level directory is exactly
    one of them.
    """
    if len(raw) > 2 and raw[1] == "/" and raw[0] in GIT_PATH_PREFIXES:
        return raw[2:]
    return raw


comment_violations = []
# Distinct from "scanned and found nothing": set only when an in-window call
# existed for the scan to examine and the guard did not disable it, but the
# scanner itself could not be loaded. Without this signal, an import failure
# (a misresolved plugin root, most commonly) is indistinguishable from a
# clean scan on both the exit code and the "pass" trace line -- the guard
# would be permanently and invisibly disabled.
comment_scan_unavailable = False
scan_stats = None
in_window_completions = [inp for (i, inp) in completion_inputs if i >= scan_from]
if in_window_completions and os.environ.get("ATG_COMMENT_GUARD", "1") != "0":
    scan_violations = None
    try:
        atg_root = os.environ.get("ATG_ROOT", "")
        if not os.path.isabs(atg_root):
            # An empty or relative value resolves "hooks" against the current
            # working directory, re-opening the shadowing hole -I closes. A
            # root that cannot be trusted is no root: report the scan as
            # unavailable rather than import from wherever cwd points.
            raise ImportError("ATG_ROOT must be an absolute path")
        sys.path.insert(0, os.path.join(atg_root, "hooks"))
        from comment_scan import violations as scan_violations
        from comment_scan import read_text_capped
        from git_added_lines import final_files_added_lines
    except Exception:
        scan_violations = None
        comment_scan_unavailable = True
    if scan_violations is not None:
        last_completion = in_window_completions[-1]
        # Precedence is decided by what was SUBMITTED, never by what parsed.
        # A diff can legitimately yield no added lines -- a pure deletion, or
        # a shape this parser does not recognise -- and falling back on an
        # empty result would scan the working tree for a submission whose
        # author already told us which lines were theirs.
        # Presence, not truthiness. An explicitly submitted empty final_diff
        # is still a statement about which lines the author added -- reading
        # it as absent would reconstruct from the working tree instead.

        # What the git walk alone knows, none of it visible in the result
        # it returns: whether its own budget stopped it, how many paths the
        # vendored exemption dropped, and whether git answered 129 to
        # --no-optional-locks so the walk ran without it. The first two shrink
        # the result; the third changes nothing about it and only says the
        # developer index was refreshed after all.
        git_stats = {}
        if ("final_diff" in last_completion or
                "final_diff_path" in last_completion):
            added_by_path = diff_added_lines(last_completion)
        else:
            added_by_path = final_files_added_lines(last_completion,
                                                    stats=git_stats)
        scan_source = ("final_diff" if ("final_diff" in last_completion or
                                        "final_diff_path" in last_completion)
                       else "final_files")
        scan_stats = {
            "source": scan_source,
            # What the evidence named, against what the scan could actually
            # read. A final_files submission whose paths are all committed
            # reports submitted > 0 and scanned == 0 -- the difference
            # between "scanned and found nothing" and "there was nothing to
            # scan", which the exit code and the pass trace line cannot
            # express on their own.
            "submitted": (len(last_completion.get("final_files") or [])
                          if scan_source == "final_files" else len(added_by_path)),
            "scanned": sum(1 for v in added_by_path.values() if v),
            "lines": sum(len(v) for v in added_by_path.values()),
            # EITHER budget cutting the work short means the same thing to a
            # reader of the trace: some of what the completion named was
            # never looked at. The budget of the git walk is already spent by
            # the time this dict is built, so it seeds the flag and the scan
            # loop below can only add to it.
            "truncated": bool(git_stats.get("truncated")),
            "vendored_skipped": int(git_stats.get("vendored_skipped") or 0),
            # git answered 129 -- its generic usage error -- to a call
            # carrying --no-optional-locks, so the walk dropped the flag and
            # every later call ran without it. Nothing in the counts moves, so
            # a run that refreshed the developer index it promised to leave
            # alone reads identically to one that did not. The marker says
            # what the walk did, never that the flag was what git objected
            # to: any malformed command line exits 129.
            "optional_locks_dropped": bool(git_stats.get("optional_locks_dropped")),
        }
        # The deadline inside violations() bounds one file, not the walk over
        # every file a completion named. Running out stops the walk, leaving
        # the rest unscanned -- which the trace records rather than passing
        # it off as a clean scan.
        scan_deadline_at = time.monotonic() + 20.0
        for fpath, added in added_by_path.items():
            if time.monotonic() > scan_deadline_at:
                scan_stats["truncated"] = True
                break
            for line, why in scan_violations(fpath, added):
                comment_violations.append({"path": fpath, "line": line, "why": why})

print(json.dumps({"error": False, "called": called,
                  "block_found": bool(qualifying), "verdict": verdict,
                  "comment_violations": comment_violations,
                  "comment_scan_unavailable": comment_scan_unavailable,
                  "scan": scan_stats}))
'
# -I isolates the interpreter: without it python3 -c puts the CURRENT WORKING
# DIRECTORY first on sys.path, so a repo-root json.py, re.py or collections.py
# would shadow the standard library inside a hook that runs unsandboxed. The
# explicit sys.path.insert of $ATG_ROOT/hooks still works under -I, so the
# comment_scan import is unaffected. -B suppresses __pycache__ writes into the
# installed plugin tree, which an uninstall would leave behind; it is a flag
# rather than PYTHONDONTWRITEBYTECODE because -I implies -E and would ignore
# the environment variable.
RESULT=$({ ATG_ROOT="$PLUGIN_ROOT" ATG_COMMENT_GUARD="$COMMENT_GUARD" python3 -I -B -c "$PY" "$TRANSCRIPT" "$TASK_ID" 2>/dev/null || echo '{"error":true}'; } | tr -d '\r')
# NOTE: deliberately ".error", not ".error // true" — jq's // operator
# substitutes on false as well as null, so ".error // true" evaluates to
# "true" for EVERY result (false // true == true in jq), which would make
# this check fire unconditionally and disable the guard entirely. RESULT
# always carries an explicit "error" key (the python script emits it on
# every path, and the fallback above sets it directly), so a plain field
# read is both correct and sufficient here.
[[ "$(echo "$RESULT" | jq -r '.error')" == "true" ]] && { trace "$TASK_ID" "skip" "parse-error"; exit 0; }

CALLED=$(echo "$RESULT" | jq -r '.called // false')
BLOCK=$(echo "$RESULT" | jq -r '.block_found // false')
VERDICT=$(echo "$RESULT" | jq -r '.verdict // ""')
trace "$TASK_ID" "parsed" "called=$CALLED block=$BLOCK verdict=$VERDICT"

# Recorded unconditionally, before any block/pass branch below, so a broken
# comment-scan import is visible in the trace log whether the close goes on
# to block for an unrelated reason (a failing verdict) or to pass. Without
# this, "scanned and found nothing" and "could not scan at all" are the same
# entry in the log.
[[ "$(echo "$RESULT" | jq -r '.comment_scan_unavailable // false')" == "true" ]] && \
    trace "$TASK_ID" "skip" "comment-scan-unavailable"

# Recorded whenever a scan ran, so an empty result stays legible: a
# submission whose paths were all committed traces submitted>0 scanned=0,
# which a scan of a real diff never does. Two of the suffixes say why a
# result is smaller than what was submitted -- a budget stopped the work, or
# the vendored exemption dropped paths -- neither of which the counts show.
# The third says the git walk dropped --no-optional-locks after a 129 and
# ran without it, which the counts do not show either.
SCAN=$(echo "$RESULT" | jq -r '.scan | select(. != null) | "src=\(.source) submitted=\(.submitted) scanned=\(.scanned) lines=\(.lines)" + (if (.vendored_skipped // 0) > 0 then " vendored-skipped=\(.vendored_skipped)" else "" end) + (if .truncated then " budget-exhausted" else "" end) + (if .optional_locks_dropped then " optional-locks-dropped" else "" end)' 2>/dev/null)
[[ -n "$SCAN" ]] && trace "$TASK_ID" "scan" "$SCAN"

# Comment hygiene runs on its own switch, ahead of the completion gate and
# independent of its verdict: a close that skipped validation entirely, and
# one that passed, are both closes whose evidence can carry a bad comment.
if [[ "$COMMENT_GUARD" != "0" ]]; then
    VIOLATIONS=$(echo "$RESULT" | jq -c '.comment_violations // []')
    VIOLATIONS_COUNT=$(echo "$VIOLATIONS" | jq 'length')
    if [[ "$VIOLATIONS_COUNT" -gt 0 ]]; then
        trace "$TASK_ID" "block" "comment-hygiene"
        {
            echo "TASK CLOSED WITH COMMENTS CARRYING CHANGE HISTORY"
            echo
            echo "Task #$TASK_ID was closed, and the evidence its last validate_completion"
            echo "submitted carries added comment(s) referencing change history."
            echo
            # Both fields come from the submitted evidence and are unbounded
            # there; a single very long line would otherwise reach the model as
            # megabytes of hook stderr it is expected to act on.
            echo "$VIOLATIONS" | jq -r '.[0:10][] | "  " + .path[0:200] + ": " + .line[0:200] + "\n    -> contains " + .why'
            echo
            # Both conditions in one payload. Reporting the comment alone
            # sends the close back for a rewrite, and the failing verdict
            # then greets it on the next attempt.
            if [[ "$COMPLETION_GUARD" != "0" && "$VERDICT" == "fail" ]]; then
                echo "That same validate_completion also returned verdict: fail, so both"
                echo "have to be addressed: rewrite the comment(s) above AND fix the"
                echo "findings from that response before re-closing."
                echo
            fi
            echo "Comments must explain non-trivial behaviour or a non-obvious invariant, and must read"
            echo "correctly to someone who never saw this change. Issue, task and version references belong"
            echo "in the commit message, not the code. Rewrite the comment(s), then:"
            echo
            echo "  1. TaskUpdate taskId=$TASK_ID status=in_progress"
            echo "  2. Fix the flagged comment(s)"
            echo "  3. Call mcp__anti-tangent__validate_completion again with the updated evidence"
            echo "  4. Re-close once the verdict is pass"
            echo
            echo "(Disable: ANTI_TANGENT_COMMENT_GUARD=0. Trace: $TRACE_LOG)"
        } >&2
        exit 2
    fi
fi

if [[ "$COMPLETION_GUARD" == "0" ]]; then
    trace "$TASK_ID" "skip" "completion-guard=0"
    exit 0
fi

if [[ "$VERDICT" == "fail" ]]; then
    trace "$TASK_ID" "block" "verdict-fail"
    {
        echo "TASK CLOSED ON A FAILED anti-tangent VERDICT"
        echo
        echo "Task #$TASK_ID went to completed, but the most recent"
        echo "validate_completion in this task's window returned verdict: fail."
        echo
        echo "The protocol is explicit: if the verdict is fail, or carries critical"
        echo "or major findings, do not report DONE. Fix the findings and re-validate."
        echo
        echo "  1. TaskUpdate taskId=$TASK_ID status=in_progress"
        echo "  2. Address the findings from that response"
        echo "  3. Call mcp__anti-tangent__validate_completion again"
        echo "  4. Re-close once the verdict is pass"
        echo
        echo "EXCEPTION: if the response carried submission_defect_only: true, the"
        echo "findings are about what you SUBMITTED, not your code. Attach the"
        echo "missing evidence (a complete final_diff, test output) and re-submit."
        echo
        echo "(Disable: ANTI_TANGENT_COMPLETION_GUARD=0. Trace: $TRACE_LOG)"
    } >&2
    exit 2
fi

if [[ "$CALLED" == "true" || "$BLOCK" == "true" ]]; then
    trace "$TASK_ID" "pass" "called=$CALLED block=$BLOCK"
    exit 0
fi

trace "$TASK_ID" "block" "no-validation"
{
    echo "TASK CLOSED WITHOUT anti-tangent validate_completion"
    echo
    echo "Task #$TASK_ID went to completed, but nothing in this task's window shows"
    echo "the completion gate ran — no mcp__anti-tangent__validate_completion call,"
    echo "and no 'anti-tangent envelope' summary_block in any subagent report."
    echo
    echo "Before moving on:"
    echo "  1. TaskUpdate taskId=$TASK_ID status=in_progress"
    echo "  2. Call mcp__anti-tangent__validate_completion with the session_id, a"
    echo "     summary, a COMPLETE final_diff (or final_diff_path), and test evidence"
    echo "  3. Paste the returned summary_block into your DONE report verbatim"
    echo "  4. Re-close once the verdict is pass"
    echo
    echo "If a subagent did the work, it must paste its summary_block into the"
    echo "report it returns — that is what makes the gate visible from here."
    echo
    echo "Do NOT simply re-close and hope this stops firing. It will not."
    echo
    echo "(Disable: ANTI_TANGENT_COMPLETION_GUARD=0. Trace: $TRACE_LOG)"
} >&2
exit 2
